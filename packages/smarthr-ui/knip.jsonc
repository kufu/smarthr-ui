// HINT: package.jsonのexportsが明示的なサブパスのみで "./lib/*" のようなワイルドカードを
// 持たないため、knipはpackage.jsonのexportsマッピング先（src/index.ts、src/types/index.ts、
// src/smarthr-ui-preset.ts、src/components/Experimental/index.ts、src/hooks/client/useSV/index.ts）
// を自動的にentryとして認識する。project設定でsrc全体を解析対象に含めることで、
// entryからreachableでない本当に未使用なfile/exportも検知できる。
//
// includeEntryExportsを有効にしているため、内部から一度も参照されないexport（＝公開専用のAPI）も
// 報告される。それらは定義元やsrc/index.ts側に /** @public */ を付けて除外する。
//
// TODO: knipをworkspace単体ではなくルートから全workspace対象で実行するようにしたい。
// packages/chartsからの参照を追えるようになり、constants.tsなどの@publicが不要になる。
// ただしignoreDependenciesなどの設定をルートへ集約する必要があり、規模が大きいため別途対応する。
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "storybook": {
    "entry": [
      ".storybook/main.ts",
      ".storybook/preview.tsx",
      ".storybook/manager.ts",
      ".storybook/tailwind.storybook.config.ts",
    ],
  },
  "entry": ["scripts/**/*.ts"],
  "project": ["src/**/*.{ts,tsx}"],
  "includeEntryExports": true,
  "tags": ["-public"],
  "ignoreDependencies": [
    "@rollup/plugin-commonjs",
    "@rollup/plugin-json",
    "@rollup/plugin-node-resolve",
    "@rollup/plugin-replace",
    "@rollup/plugin-typescript",
    "@storybook/cli",
    "playwright",
    "rollup-plugin-preserve-directives",
    "rollup-plugin-rename-node-modules",
    "tslib",
    "typescript-eslint",
  ],
  "ignoreBinaries": ["tsc", "eslint", "prettier", "knip"],
}
