{
  "name": "@smarthr/smarthr-ui-charts",
  "description": "Chart components for SmartHR UI built with React.",
  "version": "0.2.3",
  "author": "SmartHR-UI Team",
  "type": "module",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "esm",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./esm/index.js",
      "require": "./lib/index.js"
    },
    "./styles.css": "./lib/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "run-p build:*",
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./lib/styles.css",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:esm": "rollup --config rollup.esm.config.js",
    "build-storybook": "storybook build",
    "clean": "rimraf ./lib ./esm",
    "dev": "storybook dev -p 6007",
    "format": "run-s -c format:*",
    "format:eslint": "eslint --fix './src/**/*.ts{,x}'",
    "format:prettier": "prettier --write './src/**/*.ts{,x}'",
    "format:stylelint": "stylelint --fix './src/**/*.ts{,x}'",
    "lint": "run-p lint:*",
    "lint:eslint": "eslint './src/**/*.ts{,x}'",
    "lint:prettier": "prettier --check './src/**/*.ts{,x}'",
    "lint:style": "stylelint './src/**/*.ts{,x}'",
    "lint:tsc": "tsc --noEmit -p tsconfig.build.json",
    "prepublishOnly": "run-s clean build",
    "storybook": "storybook dev -p 6007",
    "test": "vitest",
    "watch:css": "tailwindcss -i ./src/styles/index.css -o ./lib/styles.css --watch"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-intl": "^7.0.4 || ^8.0.0 || ^10.0.0",
    "smarthr-ui": "workspace:^",
    "styled-components": "^5.0.1"
  },
  "dependencies": {
    "@smarthr/patternomaly": "^2.0.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "deepmerge": "^4.3.1",
    "react-chartjs-2": "^5.3.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.1.4",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/cli": "10.5.10",
    "@storybook/react": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "autoprefixer": "^10.4.27",
    "glob": "13.0.6",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^9.0.2",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intl": "^10.1.18",
    "rimraf": "^6.0.1",
    "rollup": "^4.62.3",
    "smarthr-ui": "workspace:^",
    "storybook": "10.5.10",
    "styled-components": "^5.3.11",
    "tailwind-variants": "^0.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "react",
    "react-component",
    "smarthr",
    "charts",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kufu/smarthr-ui.git",
    "directory": "packages/charts"
  },
  "bugs": {
    "url": "https://github.com/kufu/smarthr-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "standard-version": {
    "tagPrefix": "@smarthr/smarthr-ui-charts@"
  }
}
